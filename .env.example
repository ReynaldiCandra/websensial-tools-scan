# Database (required for CRM/imports; prospecting search works without it)
# Free options: https://neon.tech or https://supabase.com
# Add ?sslmode=require if your provider requires SSL.
DATABASE_URL=postgresql://user:password@localhost:5432/agency_crm

# API auth (api-server): semua endpoint kecuali /healthz menuntut header
# `x-api-key: <key>` atau `Authorization: Bearer <key>`. Wajib diisi saat
# NODE_ENV=production — tanpa ini server menolak melayani (fail closed).
# Di development boleh dikosongkan (API jalan tanpa auth, dengan warning).
ADMIN_API_KEY=change-me-to-a-long-random-string

# Password login dashboard (POST /api/auth/login). Kalau dikosongkan, login
# memakai ADMIN_API_KEY. Tidak ada API key yang dikirim ke browser.
AUTH_PASSWORD=change-me-to-a-strong-password

# Serper (optional, recommended) — Google Maps business data: rating, phone,
# website. Free 2,500 queries, no credit card: https://serper.dev
# Without SERPER_API_KEY / OUTSCRAPER_API_KEY, search falls back to OSM.
SERPER_API_KEY=
# Optional: total credits to subtract dashboard usage from (default 2500).
# Raise this after topping up Serper credits so the quota panel stays accurate.
SERPER_CREDIT_QUOTA=2500

# Outscraper (optional, legacy) — same Google Maps data. Its API key stays
# disabled until credits are added, so Serper is preferred.
OUTSCRAPER_API_KEY=

# Kunci tanda tangan cookie sesi 30 hari. Kalau kosong memakai ADMIN_API_KEY.
SESSION_SECRET=your-random-secret-here

# CORS: dashboard dan API satu origin, jadi biasanya boleh dikosongkan.
# Isi hanya kalau frontend dijalankan di origin lain (pisahkan dengan koma).
# CORS_ORIGINS=https://dashboard.example.com

# Cloudinary signed image uploads (server-only; never use VITE_ prefix)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=8080
NODE_ENV=development
