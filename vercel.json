{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/agency-crm/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://YOUR_BACKEND_URL/api/$1"
    },
    {
      "src": "/preview/(.*)",
      "dest": "https://YOUR_BACKEND_URL/preview/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
