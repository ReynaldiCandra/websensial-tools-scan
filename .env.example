# Database (required for CRM/imports; prospecting search works without it)
# Free options: https://neon.tech or https://supabase.com
# Add ?sslmode=require if your provider requires SSL.
DATABASE_URL=postgresql://user:password@localhost:5432/agency_crm

# API auth (api-server): semua endpoint kecuali /healthz menuntut header
# `x-api-key: <key>` atau `Authorization: Bearer <key>`. Wajib diisi saat
# NODE_ENV=production — tanpa ini server menolak melayani (fail closed).
# Di development boleh dikosongkan (API jalan tanpa auth, dengan warning).
ADMIN_API_KEY=change-me-to-a-long-random-string

# Frontend CRM (agency-crm): kirim `x-api-key` pada setiap request.
# Nilainya harus sama dengan ADMIN_API_KEY di atas.
VITE_API_KEY=change-me-to-a-long-random-string

# Session (required for auth if added later)
SESSION_SECRET=your-random-secret-here

# Server
PORT=8080
NODE_ENV=development
